@startuml
title RentEase - Diagramme de deploiement

skinparam shadowing false
skinparam componentStyle rectangle

actor "Visiteur / Client / Loueur / Admin" as Utilisateur

node "Appareil utilisateur" as ClientDevice {
  node "Navigateur web" as Browser {
    artifact "SPA Vue 3\nbuild Vite" as SPA
    component "Vue Router" as VueRouter
    component "Stores Pinia" as Pinia
    component "Client Axios" as Axios
    component "Firebase SDK" as FirebaseSdk
    component "Service Worker\nfirebase-messaging-sw.js" as ServiceWorker
    database "IndexedDB\nnotificationsDB" as IndexedDB
  }
}

node "Serveur applicatif" as AppServer {
  node "Serveur web\nNginx ou Apache" as WebServer {
    artifact "Assets frontend statiques" as StaticAssets
  }

  node "Runtime PHP\nPHP 8.1+" as PhpRuntime {
    component "API Laravel 10" as LaravelApi
    component "Laravel Sanctum" as Sanctum
    component "Controleurs REST" as Controllers
    component "Planificateur Laravel\nsend:rental-reminders" as Scheduler
    component "Worker de queue\nSendReservationNotification" as QueueWorker
    component "FirebaseNotificationService" as FirebaseService
  }
}

database "Base de donnees MySQL" as MySql {
  artifact "users"
  artifact "admins"
  artifact "categories"
  artifact "listings"
  artifact "reservations"
  artifact "reviews"
  artifact "password_resets"
  artifact "personal_access_tokens"
}

cloud "Firebase Cloud Messaging" as FCM
cloud "Service SMTP" as SMTP

Utilisateur --> Browser : HTTPS
Browser --> SPA
SPA --> VueRouter
SPA --> Pinia
SPA --> Axios
SPA --> FirebaseSdk

WebServer --> StaticAssets : sert le frontend
WebServer --> LaravelApi : transmet /api
Axios --> LaravelApi : REST JSON\n/api/*
LaravelApi --> Controllers
LaravelApi --> Sanctum : authentification token
Sanctum --> MySql : personal_access_tokens
Controllers --> MySql : Eloquent / PDO
Controllers --> SMTP : code de reinitialisation

FirebaseSdk --> FCM : demande token navigateur
FirebaseSdk --> LaravelApi : enregistre device_token
Scheduler --> MySql : lit les reservations a venir
Scheduler --> FirebaseService
QueueWorker --> FirebaseService
FirebaseService --> FCM : envoie notification push
FCM --> ServiceWorker : push en arriere-plan
ServiceWorker --> IndexedDB : stocke notification
ServiceWorker --> Browser : affiche notification

note right of AppServer
  Le frontend et le backend peuvent etre deployes
  sur deux serveurs separes. Ce schema montre
  le deploiement logique de l'application.
end note

note bottom of Scheduler
  Le scheduler est configure dans
  backend/app/Console/Kernel.php et utilise
  le fuseau Africa/Tunis.
end note

@enduml
